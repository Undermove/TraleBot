<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="7.2.2" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Testcontainers" Version="4.16.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Trale\Trale.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Recorded Wiktionary API responses for the translation pipeline tests (no network in tests). -->
      <None Update="Translation\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    

  <ItemGroup>
    <None Include="..\Fixtures\verb-level-cases.json" Link="Fixtures\verb-level-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Russian forms the catalog's phrases are built from: VerbMeaningBuilderTests ties the C# builder to the script's output. -->
    <None Include="..\..\scripts\verbs\ru-forms.json" Link="Verbs\ru-forms.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\sql\*.sql" Link="Sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
