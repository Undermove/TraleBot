<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Infrastructure</RootNamespace>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Cloud.Translation.V2" Version="3.5.0" />
        <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
        <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication" Version="2.3.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.25">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <PackageReference Include="OpenAI" Version="2.15.0" />
        <!-- Translation agent pipeline (Application/Translation/Pipeline): Microsoft Agent Framework over IChatClient. -->
        <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
        <!-- OpenTelemetry.* is capped at 1.17.0: the Prometheus exporter has no stable release, and with
             OpenTelemetry 1.18+ the 1.7.0-rc.1 exporter answers /metrics with an empty body. Move them together. -->
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.7.0-rc.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
        <PackageReference Include="Prometheus.Client" Version="6.3.0" />
        <PackageReference Include="Prometheus.Client.AspNetCore" Version="6.0.0" />
        <PackageReference Include="Prometheus.Client.HttpRequestDurations" Version="4.1.0" />
        <PackageReference Include="Telegram.Bot" Version="19.0.0" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
        <!-- Security pin: overrides transitive 8.0.x pulled via Microsoft.AspNetCore.Authentication (CVE-2026-33116, CVE-2026-26171) -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Application\Application.csproj" />
      <ProjectReference Include="..\Persistence\Persistence.csproj" />
    </ItemGroup>
</Project>
